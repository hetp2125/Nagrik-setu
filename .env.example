PORT=3000
NODE_ENV=production
DATA_DIR=./data
# First admin (created only when no admin exists). If omitted a random password is printed once.
ADMIN_EMAIL=chief@yourdept.gov.in
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Optional: supply keys from your KMS instead of data/secrets.json
# JWT_SECRET=...   DATA_KEY=<64 hex chars = 32 bytes>   PEPPER=...
# Aadhaar (UIDAI AUA/KUA gateway). Without it, production refuses Aadhaar unless ALLOW_MOCK_AADHAAR=true
# AADHAAR_PROVIDER_URL=https://your-aua-gateway   AADHAAR_PROVIDER_KEY=...
# AI image detector: POST raw image bytes, returns {"ai_probability":0..1}
# AI_DETECT_URL=https://detector.internal/score   AI_DETECT_KEY=...
